FROM node:22-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/resume-intelligence/package.json packages/resume-intelligence/package.json
COPY packages/object-storage/package.json packages/object-storage/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @smartrecruit-pro/api build && pnpm --filter @smartrecruit-pro/worker build
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3100
EXPOSE 3100
CMD ["sh", "-c", "node scripts/migrate-postgres.mjs && node scripts/seed-dev-postgres.mjs && node apps/api/dist/src/index.js"]
