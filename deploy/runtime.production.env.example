# Linux deployment template. Fill in on the server; do not commit the real file.
# With an external PostgreSQL instance, set PGHOST etc. or use DATABASE_URL.
PGHOST=postgres
PGPORT=5432
PGUSER=smartrecruit
PGDATABASE=smartrecruit
PGPASSWORD=
# DATABASE_URL=

# For restored databases reuse the original keys, never generate replacements.
AUTH_OTP_HMAC_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# Enterprise AI and merchant settings use separate 32-byte base64 master keys.
# Generate each once with: openssl rand -base64 32
# Restored databases MUST use their original keys.
AI_CONFIG_ENCRYPTION_KEY=
PAYMENT_ENCRYPTION_KEY=
SYSTEM_ADMIN_USER_NO=
# Keep the official HTTPS origin across deployments; same-origin also works automatically.
# Append additional exact cross-origin frontend origins only when needed.
ALLOWED_ORIGINS=https://zhaopin.longdaoec.com
RESUME_UPLOAD_RELAX_ORIGIN=false

# Configure email before registration, password reset or account changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional platform AI and payment callback settings; never copy local secrets.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_TIMEOUT_MS=120000
# PAYMENT_PUBLIC_BASE_URL=https://recruit.example.com

# Set internal URLs only for services you enable, or use private external URLs.
# OCR_SERVICE_URL=http://ocr:8090
# FUNASR_BASE_URL=http://funasr:10095/transcribe
# FUNASR_STREAM_URL=ws://funasr:10095
# FUNASR_TIMEOUT_MS=120000
# FASTER_WHISPER_BASE_URL=http://faster-whisper:10096/transcribe
# FASTER_WHISPER_TOKEN=
# WEB_PORT=5174
