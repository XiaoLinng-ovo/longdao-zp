# Linux deployment template. Fill in on the server; do not commit the real file.
# With an external PostgreSQL instance, set PGHOST etc. or use DATABASE_URL.
PGHOST=postgres
PGPORT=5432
PGUSER=smartrecruit
PGDATABASE=smartrecruit
PGPASSWORD=
# DATABASE_URL=

# For restored databases reuse the original keys, never generate replacements.
AUTH_OTP_HMAC_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
SYSTEM_ADMIN_USER_NO=
ALLOWED_ORIGINS=https://recruit.example.invalid

# Configure email before registration, password reset or account changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set internal URLs only for services you enable, or use private external URLs.
# OCR_SERVICE_URL=http://ocr:8090
# FUNASR_BASE_URL=http://funasr:10095
# FUNASR_STREAM_URL=ws://funasr:10095
# FASTER_WHISPER_BASE_URL=http://faster-whisper:10096/transcribe
# FASTER_WHISPER_TOKEN=
# WEB_PORT=5174
