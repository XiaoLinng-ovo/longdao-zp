# Copy to deploy/modelscope/runtime.env on the Notebook. Do not commit runtime.env.
# PUBLIC_ORIGIN contains protocol and host only. It does not include /proxy/7860/.
PUBLIC_ORIGIN=https://replace-with-the-modelscope-proxy-host
POSTGRES_DB=smartrecruit
POSTGRES_USER=smartrecruit
POSTGRES_PASSWORD=replace-with-a-strong-random-password
# Base64-encoded random 32-byte master key. Preserve it with the database backup.
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Authentication secrets. Generate each independently with: openssl rand -base64 48
AUTH_OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
# Exact email allowlist for accounts that intentionally do not use MFA.
AUTH_MFA_EXEMPT_EMAILS=admin@smartrecruit.local

# Only trust the private Docker network used by the bundled Nginx proxy.
AUTH_TRUSTED_PROXY_IPS=172.16.0.0/12

# SMTP for registration verification, password reset, and offer email.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-the-smtp-authorization-code
SMTP_FROM="招聘团队 <sender@example.com>"

# Enable only after configuring both Cloudflare Turnstile keys.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CPU limits sized for a single 8 vCPU / 32 GB Notebook.
WORKER_CONCURRENCY=3
FUNASR_CPU_THREADS=4
OCR_CPU_THREADS=2
FASTER_WHISPER_CPU_THREADS=2
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_LANGUAGE=zh
