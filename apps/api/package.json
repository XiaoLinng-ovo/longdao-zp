{
  "name": "@smartrecruit-pro/api",
  "version": "0.1.0",
  "private": true,
  "description": "SmartRecruit Pro Phase 1 minimal HTTP API skeleton",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "prebuild": "npm --prefix ../../packages/resume-intelligence run build",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/src/**/*.test.js dist/tests/*.test.js",
    "start": "npm run build && node dist/src/index.js",
    "dev": "npm run build && node --watch dist/src/index.js"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@smartrecruit-pro/object-storage": "workspace:*",
    "@smartrecruit-pro/resume-intelligence": "workspace:*",
    "@types/pg": "^8.23.1",
    "mammoth": "^1.12.3",
    "opencc-js": "1.4.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.0",
    "@smartrecruit-pro/enterprise-ai": "workspace:*"
  }
}
