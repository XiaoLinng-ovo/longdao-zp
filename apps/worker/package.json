{
  "name": "@smartrecruit-pro/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SmartRecruit Pro background worker skeleton for asynchronous recruiting tasks",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/tsc.mjs -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/worker.test.js",
