{
  "name": "smartrecruit-pro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/worker",
    "web",
    "packages/contracts",
    "packages/resume-intelligence",
    "packages/enterprise-ai"
  ],
  "description": "SmartRecruit Pro recruitment workflow demo with a small deployable backend",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-api-production.mjs",
    "start:production": "node scripts/start-api-production.mjs",
    "start:dev": "node scripts/start-api-local.mjs",
    "test:production-safety": "node --test scripts/tests/production-safety.test.mjs",
    "start:all": "node scripts/start-all.mjs",
    "dev": "npm --prefix web run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter smartrecruit-pro-web typecheck && pnpm --filter @smartrecruit-pro/contracts typecheck && pnpm --filter @smartrecruit-pro/resume-intelligence typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  }
}
