# 复制为服务器环境变量或 .env（不要提交真实 Key）
# 企业 AI 模型地址/密钥/模型请在「企业 AI 配置」中保存，不设置在下面的全局变量中。
# 下列 LLM_* / OPENAI_* 仅保留给未迁移的旧工具；企业 API 和持久化 Worker 不回落到全局配置。
# 平台加密主密钥：Base64 编码的随机 32 字节，API 与 Worker 必须使用同一值。
# 完成 API 构建后可执行 node scripts/provision-ai-encryption-key.mjs（只生成一次，不打印值）。
# 必须安全备份主密钥和数据库；不得随意换值，丢失主密钥后无法解密已有企业密钥。
# AI_CONFIG_ENCRYPTION_KEY=
# 生产环境必填：平台维护的 HTTPS origin 白名单（不含 /v1 路径），逗号分隔。
# 未配置白名单时生产企业 AI 调用会拒绝；如需新供应商，由平台审核后添加。
# AI_ALLOWED_BASE_URL_ORIGINS=https://api.deepseek.com,https://api.openai.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000

# Optional local PP-StructureV3 OCR service
# OCR_SERVICE_URL=http://127.0.0.1:8090

# Optional FunASR-compatible transcription service for onsite AI interviews.
# The API must return { segments: [{ spk, sentence, start, end }] } or an equivalent array.
# FUNASR_BASE_URL=http://127.0.0.1:10095/transcribe
# FUNASR_TOKEN=
# FUNASR_TIMEOUT_MS=30000

# Optional local faster-whisper fallback for interview audio chunks.
# FunASR remains the primary recognizer; this service is used only when FunASR
# is not configured or the primary request fails.
# FASTER_WHISPER_BASE_URL=http://127.0.0.1:10096/transcribe
# FASTER_WHISPER_TOKEN=
# FASTER_WHISPER_TIMEOUT_MS=120000
# FASTER_WHISPER_MODEL=base
# FASTER_WHISPER_DEVICE=cpu
# FASTER_WHISPER_COMPUTE_TYPE=int8
# FASTER_WHISPER_LANGUAGE=zh
# FASTER_WHISPER_CPU_THREADS=2
# FASTER_WHISPER_BEAM_SIZE=1
# FASTER_WHISPER_IDLE_SECONDS=60

# Legacy OpenAI-compatible settings; not the source for enterprise interview/JD/worker AI calls.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=30000

# DingTalk internal app and workflow integration
# Optional absolute path to the .env file edited from 管理后台 → 钉钉集成配置.
# ENV_FILE_PATH=C:\absolute\path\to\.env
# DINGTALK_APPROVAL_MODE=mock
# 可选值：mock（默认，仅本地模拟，不访问钉钉）、real（明确允许真实审批写入）、off
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_INTEGRATION_TOKEN=
# DINGTALK_CALLBACK_TOKEN=
# DINGTALK_CALLBACK_AES_KEY=
# DINGTALK_CALLBACK_CORP_ID=
# DINGTALK_CALLBACK_BASE_URL=https://your-public-domain.example.com
# DINGTALK_APPROVAL_RECONCILE=on
# DINGTALK_APPROVAL_RECONCILE_MS=300000

# 招聘渠道接入（管理后台「招聘渠道接入」也会写入同一组键）
# BOSS直聘企业开放平台
# CHANNEL_BOSS_ENABLED=false
# CHANNEL_BOSS_BASE_URL=
# CHANNEL_BOSS_APP_KEY=
# CHANNEL_BOSS_APP_SECRET=
# CHANNEL_BOSS_WEBHOOK_TOKEN=
# CHANNEL_BOSS_SIGNING_SECRET=
# 猎聘企业接口
# CHANNEL_LIEPIN_ENABLED=false
# CHANNEL_LIEPIN_BASE_URL=
# CHANNEL_LIEPIN_APP_KEY=
# CHANNEL_LIEPIN_APP_SECRET=
# CHANNEL_LIEPIN_WEBHOOK_TOKEN=
# CHANNEL_LIEPIN_SIGNING_SECRET=
# 前程无忧开放接口
# CHANNEL_51JOB_ENABLED=false
# CHANNEL_51JOB_BASE_URL=
# CHANNEL_51JOB_APP_KEY=
# CHANNEL_51JOB_APP_SECRET=
# CHANNEL_51JOB_WEBHOOK_TOKEN=
# CHANNEL_51JOB_SIGNING_SECRET=
# 公司官网投递入口
# CHANNEL_OFFICIAL_SITE_ENABLED=false
# CHANNEL_OFFICIAL_SITE_BASE_URL=
# CHANNEL_OFFICIAL_SITE_WEBHOOK_TOKEN=
# CHANNEL_OFFICIAL_SITE_SIGNING_SECRET=

# 将前端部署到不同域名时，填写 Cloudflare Pages 地址。
# 当前 longdao1 Pages 项目的公共地址：
# CORS_ORIGIN=https://longdao1.pages.dev

# 仅放宽简历导入建档的三个 POST 接口的来源校验；仍要求登录、权限和 CSRF Token。
# 其他招聘写操作、删除操作及平台管理接口继续使用严格白名单。
# RESUME_UPLOAD_RELAX_ORIGIN=false

# 本地 PostgreSQL（二选一：DATABASE_URL 优先于 PG*）
# DATABASE_URL=postgresql://smartrecruit:change-me-in-development@127.0.0.1:5432/smartrecruit
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=smartrecruit
# PGPASSWORD=change-me-in-development
# PGDATABASE=smartrecruit
# DB_POOL_MAX=10
# PGCONNECT_TIMEOUT_MS=5000

# Persisted worker and ClamAV resume scanning
# Set true only when ClamAV is configured and you want the quarantine gate.
RESUME_VIRUS_SCAN_ENABLED=false
# WORKER_DB_POLL=true
# Keep local OCR/LLM processing stable; raise only after measuring memory.
# WORKER_CONCURRENCY=1
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# RECRUITING_QUARANTINE_ROOT=C:\absolute\path\to\data\resumes\quarantine
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_QUARANTINE_BUCKET=resume-quarantine
S3_FORCE_PATH_STYLE=true

# Merchant payments (all channels disabled until configured in platform payment management).
# Generate once: node scripts/provision-payment-encryption-key.mjs
# Keep this key backed up securely; never rotate it without re-encrypting existing configurations.
PAYMENT_ENCRYPTION_KEY=
# Public root origin used for fixed webhook and payment-result URLs; HTTPS required.
PAYMENT_PUBLIC_BASE_URL=
# Optional exact IPs of reverse proxies which append verified X-Forwarded-For.
PAYMENT_TRUSTED_PROXY_IPS=

# Whole-interview audio playback/download requires FFmpeg. Docker includes it.
# Optional absolute executable path when ffmpeg is not on the API process PATH.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
