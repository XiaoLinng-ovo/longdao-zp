# 复制为服务器环境变量或 .env（不要提交真实 Key）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000

# Optional local PP-StructureV3 OCR service
# OCR_SERVICE_URL=http://127.0.0.1:8090

# 将前端部署到不同域名时，填写 Cloudflare Pages 地址。
# 当前 longdao1 Pages 项目的公共地址：
# CORS_ORIGIN=https://longdao1.pages.dev

# 本地 PostgreSQL（二选一：DATABASE_URL 优先于 PG*）
# DATABASE_URL=postgresql://smartrecruit:change-me-in-development@127.0.0.1:5432/smartrecruit
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=smartrecruit
# PGPASSWORD=change-me-in-development
# PGDATABASE=smartrecruit
# DB_POOL_MAX=10
# PGCONNECT_TIMEOUT_MS=5000
